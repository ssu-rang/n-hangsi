<!doctype html><html lang="ko"><head>{% set title='회원가입' %}{% include '_head.njk' %}</head><body class="interior-page auth-page"><main class="container py-5" style="max-width:520px"><section class="card shadow-sm"><div class="card-body p-4 p-lg-5"><h1 class="h3 fw-black mb-4">회원가입</h1><form method="post" action="/signup"><input type="hidden" name="_csrf" value="{{ csrfToken }}">{% for field,label,type in [['email','이메일','email'],['nickname','닉네임','text'],['password','비밀번호','password'],['passwordConfirm','비밀번호 확인','password']] %}<div class="{% if not loop.last %}mb-3{% else %}mb-4{% endif %}"><label class="form-label" for="{{ field }}">{{ label }}</label><input class="form-control" id="{{ field }}" name="{{ field }}" type="{{ type }}" value="{% if type != 'password' %}{{ form[field] or '' }}{% endif %}" required>{% if errors[field] %}<div class="text-danger small">{{ errors[field] }}</div>{% endif %}</div>{% endfor %}<button class="btn btn-primary w-100">가입하기</button></form></div></section></main>{% include '_footer.njk' %}</body></html>
