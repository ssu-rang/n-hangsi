{% if oauthEnabled %}
<div class="auth-oauth">
    <a class="btn google-auth-button" href="/oauth2/authorization/google">
        <svg class="google-auth-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285f4" d="M21.6 12.2c0-.7-.1-1.5-.2-2.2H12v4.3h5.4a4.6 4.6 0 0 1-2 3v2.8h3.5c2-1.9 3.2-4.6 3.2-7.9Z"/>
            <path fill="#34a853" d="M12 22c2.9 0 5.3-.9 7-2.6l-3.5-2.8c-.9.7-2.1 1-3.5 1a6.2 6.2 0 0 1-5.8-4.3H2.6v2.9A10.6 10.6 0 0 0 12 22Z"/>
            <path fill="#fbbc05" d="M6.2 13.3a6.4 6.4 0 0 1 0-4V6.4H2.6a10.1 10.1 0 0 0 0 9.2l3.6-2.3Z"/>
            <path fill="#ea4335" d="M12 5.2c1.6 0 3 .5 4.1 1.6l3.1-3A10.4 10.4 0 0 0 2.6 6.4l3.6 2.9A6.2 6.2 0 0 1 12 5.2Z"/>
        </svg>
        Google로 계속하기
    </a>
    <div class="auth-divider"><span>또는 이메일로 계속</span></div>
</div>
{% endif %}
