<!doctype html>
<html lang="ko">
<head>
    {% set title='N행시 - 매일 새로운 N행시' %}
    {% set titleIncludesBrand=true %}
    {% include '_head.njk' %}
</head>
<body class="home-page">
{% include '_header.njk' %}
<main class="home-container">
    {% if accountDeleted %}<div class="alert alert-success" role="status">회원탈퇴가 완료되었습니다.</div>{% endif %}
    <div class="home-layout">
        <aside class="category-sidebar" aria-label="N행시 카테고리">
            <h2>카테고리</h2>
            <div class="filter-group">
                <h3>글자 수</h3>
                <nav>
                    {% for value,label in [['all','전체'],['2','2행시'],['3','3행시'],['4','4행시'],['5','5행시']] %}
                    <a href="/?lines={{ value }}&amp;sort={{ popularSort }}"
                       class="{% if lineFilter == value %}is-active{% endif %}"
                       {% if lineFilter == value %}aria-current="page"{% endif %}>{{ label }}</a>
                    {% endfor %}
                </nav>
            </div>
        </aside>
        <div class="main-content">
            <section class="daily-overview">
                <div class="daily-prompt">
                    <div class="daily-prompt-heading">
                        <h1>{{ promptWord }}</h1>
                        <div class="daily-prompt-action">
                            <span>오늘의 단어</span>
                            <a class="btn btn-light text-primary fw-bold"
                               href="/poems/new?word={{ promptWord | urlencode }}">N행시 쓰기</a>
                        </div>
                    </div>
                    <div class="daily-recommendation">
                        {% if promptPoems.length %}
                        {% set recommended=promptPoems[0] %}
                        <div class="featured-work">
                            <div class="featured-work-label">가장 인기있는 오늘의 N행시</div>
                            {% for line in recommended.lines %}
                            <div class="poem-line">
                                <strong>{{ recommended.word[loop.index0] }}</strong><span>{{ line }}</span>
                            </div>
                            {% endfor %}
                            <div class="meta recommendation-meta">
                                {% if recommended.authorId %}<a class="author-link" href="/users/{{ recommended.authorId }}">@{{ recommended.authorName }}</a>{% else %}@{{ recommended.authorName }}{% endif %} · ★ {{ recommended.rating }} ({{ recommended.ratingCount }}) · 조회 {{ recommended.viewCount }} · 댓글 {{ recommended.commentCount }}
                            </div>
                        </div>
                        {% else %}
                        <p class="text-secondary featured-work-empty">아직 등록된 작품이 없습니다.</p>
                        {% endif %}
                        <a class="prompt-work-link" href="/poems?keyword={{ promptWord | urlencode }}">
                            {{ promptWord }} 작품 더 보기 →
                        </a>
                    </div>
                </div>
                <section class="recent-words" aria-labelledby="recent-words-title">
                    <div class="recent-words-heading">
                        <h2 id="recent-words-title">방금 올라온 단어</h2>
                    </div>
                    {% if recentWords.length %}
                    <nav class="recent-word-list" aria-label="최근 N행시 단어로 글쓰기">
                        {% for word in recentWords %}
                        <a class="recent-word-link" href="/poems/new?word={{ word | urlencode }}">{{ word }}</a>
                        {% endfor %}
                    </nav>
                    {% else %}
                    <p class="text-secondary recent-words-empty">아직 등록된 단어가 없습니다.</p>
                    {% endif %}
                </section>
            </section>
            <section class="mobile-home-category" aria-label="N행시 카테고리">
                <div class="filter-group">
                    <h3>글자 수</h3>
                    <nav>
                        {% for value,label in [['all','전체'],['2','2행시'],['3','3행시'],['4','4행시'],['5','5행시']] %}
                        <a href="/?lines={{ value }}&amp;sort={{ popularSort }}"
                           class="{% if lineFilter == value %}is-active{% endif %}"
                           {% if lineFilter == value %}aria-current="page"{% endif %}>{{ label }}</a>
                        {% endfor %}
                    </nav>
                </div>
            </section>
            <div class="d-flex justify-content-between align-items-end mb-3 home-section-head">
                <div class="popular-heading">
                    <h2 class="section-title mb-0">지금 인기 있는 N행시</h2>
                    <nav class="popular-sort" aria-label="인기 작품 정렬">
                        {% for value,label in [['rating','평점순'],['views','조회수순']] %}
                        <a href="/?lines={{ lineFilter }}&amp;sort={{ value }}"{% if popularSort == value %} class="is-active" aria-current="true"{% endif %}>{{ label }}</a>
                        {% endfor %}
                    </nav>
                </div>
                <a href="/poems">전체 보기</a>
            </div>
            <div class="trending-grid">
                {% for rank in [1,2,3,4,5] %}
                {% set poem=popularPoems[rank - 1] %}
                <div class="trending-item trending-rank-{{ rank }}{% if not poem %} is-empty{% endif %}"{% if not poem %} aria-hidden="true"{% endif %}>
                    {% if poem %}
                    <article class="card poem-card h-100">
                        <div class="card-body">
                            <span class="community-rank">#{{ rank }}</span>
                            <div class="community-content">
                                <div class="community-heading">
                                    <h3 class="h4 fw-bold"><a class="poem-title-link" href="/poems/{{ poem.id }}">{{ poem.word }}</a></h3>
                                    {% if rank == 1 %}<span class="hot-label">HOT</span>{% endif %}
                                    <span class="line-count">{{ poem.word.length }}행시</span>
                                </div>
                                {% for line in poem.lines %}
                                <div class="poem-line">
                                    <strong>{{ poem.word[loop.index0] }}</strong><span>{{ line }}</span>
                                </div>
                                {% endfor %}
                                <div class="meta">
                                    {% if poem.authorId %}<a class="author-link" href="/users/{{ poem.authorId }}">@{{ poem.authorName }}</a>{% else %}@{{ poem.authorName }}{% endif %} · ★ {{ poem.rating }} ({{ poem.ratingCount }}) · 조회 {{ poem.viewCount }} · 댓글 {{ poem.commentCount }}
                                    {% if poem.createdAt %} · {{ poem.createdAt }}{% endif %}
                                </div>
                            </div>
                        </div>
                    </article>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</main>
{% include '_footer.njk' %}
</body>
</html>
