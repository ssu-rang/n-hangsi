<!doctype html><html lang="ko"><head>{% set title='홈' %}{% include '_head.njk' %}</head><body class="home-page">{% include '_header.njk' %}
<main class="home-container py-4 py-lg-5"><div class="home-layout"><aside class="category-sidebar" aria-label="N행시 카테고리"><h2>카테고리</h2><div class="filter-group"><h3>글자 수</h3><nav>
{% for value,label in [['all','전체'],['2','2행시'],['3','3행시'],['4','4행시'],['5plus','5행시 이상']] %}<a href="/{% if value != 'all' %}?lines={{ value }}{% endif %}" class="{% if lineFilter == value %}is-active{% endif %}" {% if lineFilter == value %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
</nav></div><div class="filter-group difficulty-filter"><h3>난이도</h3><nav><span class="is-active">전체</span><span>쉬움</span><span>보통</span><span>어려움</span></nav></div></aside>
<div class="main-content"><section class="daily-overview"><div class="daily-prompt"><div class="daily-prompt-label">오늘의 제시어</div><h1>{{ promptWord }}</h1><p class="text-secondary">오늘의 단어로 N행시를 지어보세요.</p><a class="btn btn-light text-primary fw-bold" href="/poems/new?word={{ promptWord | urlencode }}">N행시 쓰기</a></div>
{% set promptPoems=[] %}{% for poem in poems %}{% if poem.word == promptWord %}{% set _=promptPoems.push(poem) %}{% endif %}{% endfor %}<div class="daily-recommendation"><p class="prompt-work-count">{{ promptPoems.length }}개의 작품이 올라왔어요</p>{% if promptPoems.length %}{% set recommended=promptPoems[0] %}<div class="featured-work"><div class="featured-work-label">가장 인기 있는 작품</div>{% for line in recommended.lines %}<div class="poem-line"><strong>{{ recommended.word[loop.index0] }}</strong><span>{{ line }}</span></div>{% endfor %}<div class="meta recommendation-meta">@{{ recommended.authorName }} · ★ {{ recommended.rating }}</div></div>{% else %}<p class="text-secondary featured-work-empty">아직 등록된 작품이 없습니다.</p>{% endif %}<a class="prompt-work-link" href="/poems?keyword={{ promptWord | urlencode }}">{{ promptWord }} 작품 더 보기 →</a></div></section>
<div class="d-flex justify-content-between align-items-end mb-3 home-section-head"><h2 class="section-title mb-0">지금 인기 있는 N행시</h2><a href="/poems">전체 보기</a></div>
{% if poems.length %}<div class="trending-grid">{% for poem in poems %}<div class="trending-item"><article class="card poem-card h-100 shadow-sm"><div class="card-body"><span class="community-rank">#{{ loop.index }}</span><div class="community-content"><div class="community-heading"><h3 class="h4 fw-bold">{{ poem.word }}</h3>{% if loop.first %}<span class="hot-label">HOT</span>{% endif %}<span class="line-count">{{ poem.word.length }}행시</span></div>{% for line in poem.lines %}<div class="poem-line"><strong>{{ poem.word[loop.index0] }}</strong><span>{{ line }}</span></div>{% endfor %}<div class="meta">@{{ poem.authorName }} · 평점 {{ poem.rating }} · 댓글 {{ poem.commentCount }}{% if poem.createdAt %} · {{ poem.createdAt }}{% endif %}</div></div><a class="stretched-link" href="/poems/{{ poem.id }}"><span class="visually-hidden">상세 보기</span></a></div></article></div>{% endfor %}</div>{% else %}<p class="empty">조건에 맞는 작품이 없습니다.</p>{% endif %}</div></div></main>{% include '_footer.njk' %}</body></html>
