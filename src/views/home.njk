<!doctype html>
<html lang="ko">
<head>
    {% set title='홈' %}
    {% include '_head.njk' %}
</head>
<body class="home-page">
{% include '_header.njk' %}
<main class="home-container">
    {% if accountDeleted %}<div class="alert alert-success" role="status">회원탈퇴가 완료되었습니다.</div>{% endif %}
    <div class="home-layout">
        <aside class="category-sidebar" aria-label="N행시 카테고리">
            <h2>카테고리</h2>
            <div class="filter-group">
                <h3>글자 수</h3>
                <nav>
                    {% for value,label in [['all','전체'],['2','2행시'],['3','3행시'],['4','4행시'],['5','5글자']] %}
                    <a href="/{% if value != 'all' %}?lines={{ value }}{% endif %}"
                       class="{% if lineFilter == value %}is-active{% endif %}"
                       {% if lineFilter == value %}aria-current="page"{% endif %}>{{ label }}</a>
                    {% endfor %}
                </nav>
            </div>
            <div class="home-sponsor-stack" aria-label="카테고리 광고">
                <aside class="home-sponsor-sidebar" data-ad-provider="network" data-ad-slot="home-sidebar-1" data-ad-format="vertical" data-ad-mobile-format="horizontal"><span class="ad-mark">ADVERTISEMENT</span><div class="ad-slot-content"></div></aside>
                <aside class="home-sponsor-sidebar" data-ad-provider="network" data-ad-slot="home-sidebar-2" data-ad-format="vertical" data-ad-mobile-format="horizontal"><span class="ad-mark">ADVERTISEMENT</span><div class="ad-slot-content"></div></aside>
                <aside class="home-sponsor-sidebar" data-ad-provider="network" data-ad-slot="home-sidebar-3" data-ad-format="vertical" data-ad-mobile-format="horizontal"><span class="ad-mark">ADVERTISEMENT</span><div class="ad-slot-content"></div></aside>
            </div>
        </aside>
        <div class="main-content">
            <section class="daily-overview">
                <div class="daily-prompt">
                    <div class="daily-prompt-heading">
                        <h1>{{ promptWord }}</h1>
                        <div class="daily-prompt-action">
                            <span>오늘의 단어</span>
                            <a class="btn btn-light text-primary fw-bold"
                               href="/poems/new?word={{ promptWord | urlencode }}">N행시 쓰기</a>
                        </div>
                    </div>
                    <aside class="home-house-banner" aria-label="자체 광고 안내">
                        <span class="house-banner-mark">ADVERTISEMENT</span>
                        <a class="house-banner-content" href="/advertising"><strong><em class="house-banner-initial">광</em>고 자리 비어있습니다<br><em class="house-banner-initial">고</em>민 말고 들어오세요</strong></a>
                    </aside>
                </div>
                <div class="daily-recommendation">
                    <p class="prompt-work-count">{{ promptPoems.length }}개의 작품이 올라왔어요</p>
                    {% if promptPoems.length %}
                    {% set recommended=promptPoems[0] %}
                    <div class="featured-work">
                        <div class="featured-work-label">가장 인기 있는 작품</div>
                        {% for line in recommended.lines %}
                        <div class="poem-line">
                            <strong>{{ recommended.word[loop.index0] }}</strong><span>{{ line }}</span>
                        </div>
                        {% endfor %}
                        <div class="meta recommendation-meta">
                            @{{ recommended.authorName }} · ★ {{ recommended.rating }}
                        </div>
                    </div>
                    {% else %}
                    <p class="text-secondary featured-work-empty">아직 등록된 작품이 없습니다.</p>
                    {% endif %}
                    <a class="prompt-work-link" href="/poems?keyword={{ promptWord | urlencode }}">
                        {{ promptWord }} 작품 더 보기 →
                    </a>
                </div>
            </section>
            <aside class="home-sponsor-between" aria-label="광고 영역" data-ad-provider="network" data-ad-slot="home-mobile-between" data-ad-format="horizontal" data-ad-mobile-format="horizontal">
                <span class="ad-mark">ADVERTISEMENT</span>
                <div class="ad-slot-content"></div>
            </aside>
            <section class="mobile-home-category" aria-label="N행시 카테고리">
                <div class="filter-group">
                    <h3>글자 수</h3>
                    <nav>
                        {% for value,label in [['all','전체'],['2','2행시'],['3','3행시'],['4','4행시'],['5','5글자']] %}
                        <a href="/{% if value != 'all' %}?lines={{ value }}{% endif %}"
                           class="{% if lineFilter == value %}is-active{% endif %}"
                           {% if lineFilter == value %}aria-current="page"{% endif %}>{{ label }}</a>
                        {% endfor %}
                    </nav>
                </div>
            </section>
            <div class="d-flex justify-content-between align-items-end mb-3 home-section-head">
                <h2 class="section-title mb-0">지금 인기 있는 N행시</h2>
                <a href="/poems">전체 보기</a>
            </div>
            <div class="trending-grid">
                {% for rank in [1,2,3,4,5] %}
                {% set poem=popularPoems[rank - 1] %}
                <div class="trending-item trending-rank-{{ rank }}{% if not poem %} is-empty{% endif %}">
                    <article class="card poem-card h-100">
                        <div class="card-body">
                            <span class="community-rank">#{{ rank }}</span>
                            <div class="community-content">
                                {% if poem %}
                                <div class="community-heading">
                                    <h3 class="h4 fw-bold"><a class="poem-title-link" href="/poems/{{ poem.id }}">{{ poem.word }}</a></h3>
                                    {% if rank == 1 %}<span class="hot-label">HOT</span>{% endif %}
                                    <span class="line-count">{{ poem.word.length }}행시</span>
                                </div>
                                {% for line in poem.lines %}
                                <div class="poem-line">
                                    <strong>{{ poem.word[loop.index0] }}</strong><span>{{ line }}</span>
                                </div>
                                {% endfor %}
                                <div class="meta">
                                    @{{ poem.authorName }} · 평점 {{ poem.rating }} · 댓글 {{ poem.commentCount }}
                                    {% if poem.createdAt %} · {{ poem.createdAt }}{% endif %}
                                </div>
                                {% else %}
                                <p class="popular-slot-empty">인기 작품을 기다리고 있어요.</p>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                </div>
                {% endfor %}
                <aside class="home-sponsor-feed home-sponsor-feed-rank-1-2" data-ad-provider="network" data-ad-slot="home-feed-1" data-ad-format="vertical" data-ad-mobile-format="horizontal">
                    <span class="ad-mark">ADVERTISEMENT</span>
                    <div class="ad-slot-content"></div>
                </aside>
                <aside class="home-sponsor-feed home-sponsor-feed-rank-3-4" data-ad-provider="network" data-ad-slot="home-feed-2" data-ad-format="vertical" data-ad-mobile-format="horizontal">
                    <span class="ad-mark">ADVERTISEMENT</span>
                    <div class="ad-slot-content"></div>
                </aside>
                <aside class="home-sponsor-feed home-sponsor-feed-rank-5" data-ad-provider="network" data-ad-slot="home-feed-3" data-ad-format="rectangle" data-ad-mobile-format="horizontal">
                    <span class="ad-mark">ADVERTISEMENT</span>
                    <div class="ad-slot-content"></div>
                </aside>
            </div>
        </div>
    </div>
</main>
{% include '_footer.njk' %}
</body>
</html>
