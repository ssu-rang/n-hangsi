<section class="combined-write" id="write-poem" aria-labelledby="write-poem-title">
    <div class="combined-section-head">
        <h2 id="write-poem-title">글쓰기</h2>
    </div>
    <form class="write-card" method="post" action="/poems">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <label for="word" class="form-label fw-bold">제시어</label>
        <input id="word" data-poem-word class="form-control form-control-lg"
               name="word" value="{{ writeForm.word }}" minlength="2" maxlength="5"
               required placeholder="2~5글자 단어">
        {% if writeErrors.word %}<div class="text-danger small mt-1">{{ writeErrors.word }}</div>{% endif %}
        <div data-poem-preview class="form-text mb-4">제시어를 입력하세요.</div>
        {% if writeErrors.lines %}<div class="text-danger small mb-2">{{ writeErrors.lines }}</div>{% endif %}
        <div data-poem-lines>
            {% for line in writeForm.lines %}
            <div class="mb-3">
                <label class="form-label fw-semibold" for="line-{{ loop.index0 }}">
                    {{ writeForm.word[loop.index0] }}로 시작하는 문장
                </label>
                <input class="form-control" id="line-{{ loop.index0 }}"
                       name="lines[{{ loop.index0 }}]" value="{{ line }}" maxlength="80" required>
                {% if writeErrors['line' + loop.index0] %}
                <div class="text-danger small">{{ writeErrors['line' + loop.index0] }}</div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        <div class="d-flex justify-content-end mt-4">
            <button class="btn btn-primary" type="submit">등록하기</button>
        </div>
    </form>
    <div class="combined-write-ads" aria-label="광고">
        <aside class="combined-write-ad" aria-label="광고 영역"><span class="ad-mark">ADVERTISEMENT</span></aside>
        <aside class="combined-write-ad" aria-label="광고 영역"><span class="ad-mark">ADVERTISEMENT</span></aside>
        <aside class="combined-write-ad combined-write-ad-landscape" aria-label="광고 영역"><span class="ad-mark">ADVERTISEMENT</span></aside>
    </div>
</section>
