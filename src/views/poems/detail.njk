<!doctype html>
<html lang="ko">
<head>
    {% set title=poem.word %}
    {% include '_head.njk' %}
</head>
<body class="interior-page detail-page">
{% include '_header.njk' %}
<main class="container py-5" style="max-width:900px">
    <article class="detail">
        <h1>{{ poem.word }}</h1>
        <div class="detail-author">
            <span class="avatar">{{ poem.authorName[0] }}</span>
            <div><strong>{{ poem.authorName }}</strong><div class="small text-secondary">{{ poem.createdAt }}</div></div>
        </div>
        <div class="detail-lines">
            {% for line in poem.lines %}
            <div class="poem-line"><strong>{{ poem.word[loop.index0] }}</strong><span>{{ line }}</span></div>
            {% endfor %}
        </div>
        <div class="detail-meta">
            <strong class="rating">★ {{ poem.rating }}</strong>
            <span>평가 {{ poem.ratingCount }}</span><span>댓글 {{ poem.commentCount }}</span>
        </div>
        {% if currentUser %}
        <div class="detail-actions">
            <form class="d-inline-flex gap-2" method="post" action="/poems/{{ poem.id }}/ratings">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <label class="visually-hidden" for="score">평점</label>
                <select id="score" name="score" class="form-select form-select-sm">
                    {% for score in [5,4,3,2,1] %}<option value="{{ score }}">{{ score }}점</option>{% endfor %}
                </select>
                <button class="btn btn-sm btn-primary">평가</button>
            </form>
            <form method="post" action="/poems/{{ poem.id }}/saves">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                {% if poem.saved %}
                <input type="hidden" name="_method" value="delete">
                <button class="btn btn-outline-secondary">저장 취소</button>
                {% else %}
                <button class="btn btn-outline-primary">저장</button>
                {% endif %}
            </form>
        </div>
        {% endif %}
    </article>
    {% if currentUser %}
    <section class="report-form-section" aria-labelledby="report-title">
        <div class="section-head"><h2 id="report-title">작품 신고</h2></div>
        {% if reportSubmitted %}<div class="alert alert-success">신고가 접수되었습니다.</div>{% endif %}
        {% if reportDuplicate %}<div class="alert alert-warning">이미 신고한 작품입니다.</div>{% endif %}
        {% if reportError %}<div class="alert alert-danger">{{ reportError }}</div>{% endif %}
        <form method="post" action="/poems/{{ poem.id }}/reports">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label class="form-label" for="report-reason">신고 사유</label>
            <textarea id="report-reason" name="reason" class="form-control" minlength="3" maxlength="500" required></textarea>
            <button class="btn btn-outline-secondary mt-2" type="submit">신고하기</button>
        </form>
    </section>
    {% endif %}
    <section class="comments">
        <div class="section-head"><h2>댓글 {{ poem.commentCount }}</h2></div>
        {% if currentUser %}
        <form method="post" action="/poems/{{ poem.id }}/comments" class="comment-form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label class="visually-hidden" for="comment">댓글</label>
            <textarea id="comment" name="content" class="form-control" required maxlength="300"
                      placeholder="따뜻한 의견을 남겨주세요"></textarea>
            <button class="btn btn-primary">등록</button>
        </form>
        {% if commentError %}<div class="text-danger small mb-3">{{ commentError }}</div>{% endif %}
        {% else %}
        <p class="mb-4 text-secondary">댓글 작성과 작품 저장은 <a href="/login">로그인</a> 후 이용할 수 있습니다.</p>
        {% endif %}
        {% for comment in comments %}
        <div class="comment"><strong>{{ comment.authorName }}</strong><p class="mb-0 mt-1">{{ comment.content }}</p></div>
        {% endfor %}
        {% if not comments.length %}<p class="text-secondary py-4 mb-0">아직 댓글이 없습니다.</p>{% endif %}
    </section>
</main>
{% include '_footer.njk' %}
</body>
</html>
