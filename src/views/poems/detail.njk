<!doctype html><html lang="ko"><head>{% set title=poem.word %}{% include '_head.njk' %}</head><body class="interior-page detail-page">{% include '_header.njk' %}<main class="container py-5" style="max-width:800px"><article class="card shadow-sm"><div class="card-body p-4 p-lg-5"><h1 class="display-6 fw-black">{{ poem.word }}</h1><div class="d-flex align-items-center gap-2 mb-4"><span class="avatar">{{ poem.authorName[0] }}</span><div><strong>{{ poem.authorName }}</strong><div class="small text-secondary">{{ poem.createdAt }}</div></div></div><div class="my-4">{% for line in poem.lines %}<div class="poem-line mb-2"><strong>{{ poem.word[loop.index0] }}</strong><span>{{ line }}</span></div>{% endfor %}</div><div class="border-top pt-3 d-flex gap-3 text-secondary"><strong class="rating">★ {{ poem.rating }}</strong><span>평가 {{ poem.ratingCount }}</span><span>댓글 {{ poem.commentCount }}</span></div>
{% if currentUser %}<div class="mt-3"><form class="d-inline-flex gap-2 me-2" method="post" action="/poems/{{ poem.id }}/ratings"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label class="visually-hidden" for="score">평점</label><select id="score" name="score" class="form-select form-select-sm">{% for score in [5,4,3,2,1] %}<option value="{{ score }}">{{ score }}점</option>{% endfor %}</select><button class="btn btn-sm btn-warning">평가</button></form><form class="d-inline" method="post" action="/poems/{{ poem.id }}/saves"><input type="hidden" name="_csrf" value="{{ csrfToken }}">{% if poem.saved %}<input type="hidden" name="_method" value="delete"><button class="btn btn-outline-secondary">저장 취소</button>{% else %}<button class="btn btn-outline-primary">저장</button>{% endif %}</form></div>{% endif %}</div></article>
<section class="card shadow-sm mt-3"><div class="card-body p-4"><h2 class="h5 fw-bold">댓글</h2>{% if currentUser %}<form method="post" action="/poems/{{ poem.id }}/comments" class="d-flex gap-2 mb-4"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label class="visually-hidden" for="comment">댓글</label><textarea id="comment" name="content" class="form-control" required maxlength="300" placeholder="댓글을 입력하세요"></textarea><button class="btn btn-primary">등록</button></form>{% if commentError %}<div class="text-danger small mb-3">{{ commentError }}</div>{% endif %}{% else %}<p class="mb-4 text-secondary">댓글 작성과 작품 저장은 <a href="/login">로그인</a> 후 이용할 수 있습니다.</p>{% endif %}{% for comment in comments %}<div class="border-top py-3"><strong>{{ comment.authorName }}</strong><p class="mb-0 mt-1">{{ comment.content }}</p></div>{% endfor %}</div></section></main>{% include '_footer.njk' %}</body></html>
