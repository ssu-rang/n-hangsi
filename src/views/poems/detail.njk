<!doctype html>
<html lang="ko">
<head>
    {% set title=poem.word %}
    {% include '_head.njk' %}
</head>
<body class="interior-page detail-page">
{% include '_header.njk' %}
<main class="container py-5 detail-layout">
    <div class="detail-column">
        <article class="detail">
        <h1>{{ poem.word }}</h1>
        <div class="detail-author">
            <span class="avatar">{{ poem.authorName[0] }}</span>
            <div><strong>{{ poem.authorName }}</strong><div class="small text-secondary">{{ poem.createdAt }}</div></div>
        </div>
        <div class="detail-lines">
            {% for line in poem.lines %}
            <div class="poem-line"><strong>{{ poem.word[loop.index0] }}</strong><span>{{ line }}</span></div>
            {% endfor %}
        </div>
        <div class="detail-meta">
            <strong class="rating">★ {{ poem.rating }}</strong>
            <span>평가 {{ poem.ratingCount }}</span><span>댓글 {{ poem.commentCount }}</span>
            {% if currentUser %}
            <form class="detail-save-form" method="post" action="/poems/{{ poem.id }}/saves">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                {% if poem.saved %}<input type="hidden" name="_method" value="delete">{% endif %}
                <button class="bookmark-button{% if poem.saved %} is-saved{% endif %}" type="submit"
                        aria-label="{% if poem.saved %}저장 취소{% else %}작품 저장{% endif %}"
                        title="{% if poem.saved %}저장 취소{% else %}작품 저장{% endif %}">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 3.75A1.75 1.75 0 0 1 7.75 2h8.5A1.75 1.75 0 0 1 18 3.75V22l-6-3.75L6 22V3.75Z"/>
                    </svg>
                </button>
            </form>
            {% endif %}
        </div>
        {% if currentUser %}
        {% if reportSubmitted %}<div class="alert alert-success mt-3">신고가 접수되었습니다.</div>{% endif %}
        {% if reportDuplicate %}<div class="alert alert-warning mt-3">이미 신고한 작품입니다.</div>{% endif %}
        {% if reportError %}<div class="alert alert-danger mt-3">{{ reportError }}</div>{% endif %}
        <div class="detail-actions">
            <form class="rating-form" method="post" action="/poems/{{ poem.id }}/ratings">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <label class="visually-hidden" for="score">평점</label>
                <select id="score" name="score" class="form-select form-select-sm">
                    {% for score in [5,4,3,2,1] %}<option value="{{ score }}">{{ score }}점</option>{% endfor %}
                </select>
                <button class="btn btn-sm btn-primary">평가</button>
            </form>
            <section class="report-section" aria-label="작품 신고">
                <details class="report-disclosure"{% if reportError %} open{% endif %}>
                    <summary class="report-icon-button" aria-label="작품 신고" title="작품 신고">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 14v-3a5 5 0 0 1 10 0v3M6 15h12v3H6zM4 20h16M12 2v2M4.5 5.5 6 7m13.5-1.5L18 7M2 12h2m16 0h2"/>
                        </svg>
                    </summary>
                    <form method="post" action="/poems/{{ poem.id }}/reports">
                        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                        <label class="form-label" for="report-reason">신고 내용</label>
                        <textarea id="report-reason" name="reason" class="form-control" minlength="3" maxlength="500" required
                                  placeholder="신고 사유를 구체적으로 적어주세요."></textarea>
                        <button class="btn btn-primary mt-2" type="submit">신고 접수</button>
                    </form>
                </details>
            </section>
        </div>
        {% endif %}
        </article>
    </div>
    <section class="comments">
        <div class="section-head"><h2>댓글 {{ poem.commentCount }}</h2></div>
        {% if currentUser %}
        <form method="post" action="/poems/{{ poem.id }}/comments" class="comment-form">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <label class="visually-hidden" for="comment">댓글</label>
            <textarea id="comment" name="content" class="form-control" required maxlength="300"
                      placeholder="의견을 남겨주세요"></textarea>
            <button class="btn btn-primary">등록</button>
        </form>
        {% if commentError %}<div class="text-danger small mb-3">{{ commentError }}</div>{% endif %}
        {% else %}
        <p class="mb-4 text-secondary">댓글 작성과 작품 저장은 <a href="/login">로그인</a> 후 이용할 수 있습니다.</p>
        {% endif %}
        {% for comment in comments %}
        <div class="comment" id="comment-{{ comment.id }}">
            <div class="comment-head">
                <strong>{{ comment.authorName }}</strong>
                {% if currentUser %}
                <div class="comment-actions">
                    {% if currentUser.id == comment.authorId %}
                    <details class="comment-edit"{% if commentEditId == comment.id %} open{% endif %}>
                        <summary class="btn btn-outline-secondary btn-sm">수정</summary>
                        <form method="post" action="/poems/{{ poem.id }}/comments/{{ comment.id }}">
                            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                            <label class="visually-hidden" for="comment-edit-{{ comment.id }}">댓글 수정</label>
                            <textarea id="comment-edit-{{ comment.id }}" name="content" class="form-control"
                                      required maxlength="300">{{ comment.content }}</textarea>
                            {% if commentEditId == comment.id and commentEditError %}
                            <div class="text-danger small mt-1">{{ commentEditError }}</div>
                            {% endif %}
                            <button class="btn btn-primary btn-sm mt-2" type="submit">수정 완료</button>
                        </form>
                    </details>
                    {% endif %}
                    <details class="comment-report"{% if commentReportId == comment.id and commentReportError %} open{% endif %}>
                        <summary class="report-icon-button report-icon-button-small" aria-label="댓글 신고" title="댓글 신고">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M7 14v-3a5 5 0 0 1 10 0v3M6 15h12v3H6zM4 20h16M12 2v2M4.5 5.5 6 7m13.5-1.5L18 7M2 12h2m16 0h2"/>
                            </svg>
                        </summary>
                        <form method="post" action="/poems/{{ poem.id }}/comments/{{ comment.id }}/reports">
                            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                            <label class="form-label" for="comment-report-reason-{{ comment.id }}">신고 내용</label>
                            <textarea id="comment-report-reason-{{ comment.id }}" name="reason" class="form-control"
                                      minlength="3" maxlength="500" required placeholder="신고 사유를 구체적으로 적어주세요."></textarea>
                            {% if commentReportId == comment.id and commentReportError %}
                            <div class="text-danger small mt-1">{{ commentReportError }}</div>
                            {% endif %}
                            <button class="btn btn-primary btn-sm mt-2" type="submit">신고 접수</button>
                        </form>
                    </details>
                </div>
                {% endif %}
            </div>
            {% if commentReportId == comment.id and commentReportSubmitted %}<div class="alert alert-success py-2 mt-2">댓글 신고가 접수되었습니다.</div>{% endif %}
            {% if commentReportId == comment.id and commentReportDuplicate %}<div class="alert alert-warning py-2 mt-2">이미 신고한 댓글입니다.</div>{% endif %}
            <p class="mb-0 mt-1">{{ comment.content }}</p>
        </div>
        {% endfor %}
        {% if not comments.length %}<p class="text-secondary py-4 mb-0">아직 댓글이 없습니다.</p>{% endif %}
        <aside class="detail-comment-ad" aria-label="광고 영역" data-ad-provider="network"
               data-ad-slot="poem-detail-comments" data-ad-format="rectangle" data-ad-mobile-format="rectangle">
            <span class="ad-mark">ADVERTISEMENT</span>
            <div class="ad-slot-content"></div>
        </aside>
    </section>
</main>
{% include '_footer.njk' %}
</body>
</html>
