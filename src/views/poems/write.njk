<!doctype html>
<html lang="ko">
<head>
    {% set title='글쓰기' %}
    {% include '_head.njk' %}
</head>
<body class="interior-page write-page">
{% include '_header.njk' %}
<main class="container py-5 write-layout-shell">
    <div class="write-layout">
        <section class="write-main">
            <section class="page-head">
                <nav class="poem-page-tabs" aria-label="작품 메뉴">
                    <a class="section-title" href="/poems">작품 찾기</a>
                    <h1 class="section-title" aria-current="page">글쓰기</h1>
                </nav>
            </section>
            <form class="card shadow-sm write-card" method="post" action="/poems">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="card-body p-4 p-lg-5">
            <label for="word" class="form-label fw-bold">제시어</label>
            <input id="word" data-poem-word class="form-control form-control-lg"
                   name="word" value="{{ form.word }}" minlength="2" maxlength="5"
                   pattern="[가-힣]{2,5}" title="완성된 한글 2~5자로 입력해 주세요."
                   required placeholder="2~5글자 단어">
            {% if errors.word %}
            <div class="text-danger small mt-1">{{ errors.word }}</div>
            {% endif %}
            <div data-poem-preview class="form-text mb-4">제시어를 입력하세요.</div>
            {% if errors.lines %}
            <div class="text-danger small mb-2">{{ errors.lines }}</div>
            {% endif %}
            <div data-poem-lines>
                {% for line in form.lines %}
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="line-{{ loop.index0 }}">
                        {{ form.word[loop.index0] }}로 시작하는 문장
                    </label>
                    <input class="form-control" id="line-{{ loop.index0 }}" data-poem-line
                           name="lines[{{ loop.index0 }}]" value="{{ line }}"
                           maxlength="80" required>
                    {% if errors['line' + loop.index0] %}
                    <div class="text-danger small" data-line-error>{{ errors['line' + loop.index0] }}</div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            <div class="write-form-actions mt-4">
                <p class="write-sharing-note">작성한 N행시는 N행시 공식 인스타그램 등 SNS에 소개될 수 있어요.</p>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary" href="/">취소</a>
                    <button class="btn btn-primary" type="submit">등록하기</button>
                </div>
            </div>
        </div>
            </form>
        </section>
        <aside class="word-list" aria-labelledby="word-list-title">
            <div class="word-list-head">
                <h2 id="word-list-title">단어 목록</h2>
                <p>마음에 드는 단어를 골라보세요.</p>
            </div>
            <nav>
                {% for word in suggestedWords %}
                <a href="/poems/new?word={{ word | urlencode }}"{% if form.word == word %} class="is-active" aria-current="true"{% endif %}>
                    <span>{{ word }}</span><small>{{ word.length }}행시</small>
                </a>
                {% endfor %}
            </nav>
        </aside>
    </div>
</main>
{% include '_footer.njk' %}
</body>
</html>
