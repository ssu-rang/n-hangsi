<!doctype html><html lang="ko"><head>{% set title='프로필' %}{% include '_head.njk' %}</head><body class="interior-page profile-page">{% include '_header.njk' %}<main class="container py-5"><section class="d-flex align-items-center gap-3 mb-4"><span class="avatar fs-3" style="width:4rem;height:4rem">{{ user.nickname[0] }}</span><div><div class="page-label">PROFILE</div><h1 class="h2 fw-black mb-1">{{ user.nickname }}</h1><p class="text-secondary mb-0">{{ user.bio }}</p></div></section><div class="row g-3 mb-4">{% for value,label in [[user.poemCount,'작성 작품'],[user.averageRating if user.averageRating != null else '-', '평균 별점'],[user.ratingCount,'총 평가']] %}<div class="col-4"><div class="card text-center"><div class="card-body"><strong class="fs-4">{{ value }}</strong><div class="small text-secondary">{{ label }}</div></div></div></div>{% endfor %}</div><h2 class="h4 fw-bold">작성한 N행시</h2><div class="row g-3">{% for poem in poems %}<div class="col-md-6"><div class="card poem-card h-100"><div class="card-body"><h3 class="h5">{{ poem.word }}</h3><a class="stretched-link" href="/poems/{{ poem.id }}"><span class="visually-hidden">상세 보기</span></a></div></div></div>{% endfor %}</div></main>{% include '_footer.njk' %}</body></html>
