<!doctype html>
<html lang="ko">
<head>{% set title='프로필' %}{% include '_head.njk' %}</head>
<body class="interior-page profile-page">
{% include '_header.njk' %}
<main class="container py-5">
    <section class="profile">
        <span class="avatar large">{{ user.nickname[0] }}</span>
        <div><h1>{{ user.nickname }}</h1><p class="text-secondary mb-0">{{ user.bio or '아직 소개가 없습니다.' }}</p></div>
    </section>
    <section class="profile-stats" aria-label="활동 통계">
        {% for value,label in [[user.poemCount,'작성 작품'],[user.averageRating if user.averageRating != null else '-', '평균 별점'],[user.ratingCount,'총 평가']] %}
        <div><strong>{{ value }}</strong><span>{{ label }}</span></div>
        {% endfor %}
    </section>
    <div class="section-head profile-section-head"><h2>작성한 N행시</h2></div>
    <div class="profile-poems">
        {% for poem in poems %}
        <article class="profile-poem">
            <span class="line-count">{{ poem.word.length }}행시</span>
            <h3>{{ poem.word }}</h3>
            <div class="meta">@{{ poem.authorName }} · 평점 {{ poem.rating }}</div>
            <a class="stretched-link" href="/poems/{{ poem.id }}"><span class="visually-hidden">상세 보기</span></a>
        </article>
        {% endfor %}
    </div>
    {% if not poems.length %}<div class="empty-state"><h2>아직 작성한 작품이 없습니다</h2></div>{% endif %}
    {% if currentUser and currentUser.id == user.id %}
    <section class="account-settings">
        <h2>계정 관리</h2>
        <p>계정을 더 이상 사용하지 않는다면 회원탈퇴를 진행할 수 있습니다.</p>
        <a class="btn btn-outline-danger btn-sm" href="/profile/delete">회원탈퇴</a>
    </section>
    {% endif %}
</main>
{% include '_footer.njk' %}
</body>
</html>
